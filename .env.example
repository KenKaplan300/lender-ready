# Local development (`npm run dev`): copy to .env.local.
# In production these come from wrangler.jsonc vars plus the
# MAILCHIMP_API_KEY secret (npx wrangler secret put MAILCHIMP_API_KEY).
MAILCHIMP_SERVER=us7
MAILCHIMP_AUDIENCE_ID=5839947fe8
MAILCHIMP_API_KEY=

# Resources page (Videos, Articles, Third-Party Tools) reads from the
# same Supabase project as k2commercialfinance's `content` and
# `resources` tables. NEXT_PUBLIC_SUPABASE_URL / ANON_KEY are safe to
# expose; in production set SUPABASE_SERVICE_ROLE_KEY as a secret
# (npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY) — never commit it
# or add it to wrangler.jsonc vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
